+    /// Arms the one-shot debounce that fires `HoverDwellTick` once the
+    /// cursor has been still for `HOVER_DWELL_MS`.
+    ///
+    /// Every `ViewportMove` arms a fresh timer, so a moving cursor never
+    /// reaches the deadline and never costs a frame; only the final pause
+    /// survives long enough to deliver the tick. This replaces a
+    /// `window::frames()` subscription that re-rendered the viewport at
+    /// refresh rate purely to discover the cursor was still moving.
+    pub(in crate::app) fn hover_dwell_debounce(&self) -> Task<Message> {
+        if self.hover_dwell.is_none() {
+            return Task::none();
+        }
+        let delay = std::time::Duration::from_millis(crate::app::HOVER_DWELL_MS as u64);
+
+        // Native uses the smol runtime iced is configured with; on web iced
+        // switches to wasm_bindgen and `smol` does not even build, so use the
+        // browser's own timer.
+        #[cfg(not(target_arch = "wasm32"))]
+        let wait = async move {
+            smol::Timer::after(delay).await;
+        };
+
+        #[cfg(target_arch = "wasm32")]
+        let wait = async move {
+            let schedule = |resolve: js_sys::Function| {
+                web_sys::window().and_then(|w| {
+                    w.set_timeout_with_callback_and_timeout_and_arguments_0(
+                        resolve.unchecked_ref(),
+                        delay.as_millis() as i32,
+                    )
+                    .ok()
+                })
+            };
+            let promise = js_sys::Promise::new(&mut |resolve, _| {
+                if schedule(resolve).is_none() {
+                    web_sys::console::error_1(
+                        &"OpenCADStudio: hover dwell timer unavailable".into(),
+                    );
+                }
+            });
+            let _ = wasm_bindgen_futures::JsFuture::from(promise).await;
+        };
+
+        Task::perform(wait, |_| Message::HoverDwellTick)
+    }
