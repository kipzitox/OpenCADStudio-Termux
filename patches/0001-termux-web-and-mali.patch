+/// Best-effort MIME type for a downloaded file, derived from its extension.
+/// `application/octet-stream` is the safe fallback when nothing matches.
+#[cfg(target_arch = "wasm32")]
+fn mime_for_download(name: &str) -> &'static str {
+    let lower = name.to_ascii_lowercase();
+    let ext = lower.rsplit('.').next().unwrap_or("");
+    match ext {
+        "dwg" => "application/acad",
+        "dxf" => "application/dxf",
+        "pdf" => "application/pdf",
+        "stl" => "model/stl",
+        "step" | "stp" => "application/step",
+        "obj" => "model/obj",
+        "zip" => "application/zip",
+        "png" => "image/png",
+        "svg" => "image/svg+xml",
+        "csv" => "text/csv",
+        "txt" | "log" => "text/plain",
+        "json" => "application/json",
+        _ => "application/octet-stream",
+    }
+}
