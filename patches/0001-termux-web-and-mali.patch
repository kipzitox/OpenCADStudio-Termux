 use device_capabilities::DeviceCapabilities;
 
 /// MSAA sample count for the main drawing pipelines.
+///
+/// Defaults to 4x, which is what the pipelines are validated against, but drops
+/// to 1x when the app has already decided it is running on a software
+/// rasteriser (`cli::gui_config().compat_renderer`, set by gpu_backend.rs for
+/// llvmpipe/lavapipe/WARP/SwiftShader). MSAA multiplies fragment work by the
+/// sample count, and on a CPU rasteriser that is the single largest per-frame
+/// cost: at 2705x1531, 4x means 16.6M samples shaded per frame against 4.14M
+/// at 1x. The visual cost is jaggier edges, which is the right trade for a
+/// machine with no GPU.
+///
+/// `OCS_MSAA_SAMPLES` overrides both, for A/B measurement.
+fn msaa_samples() -> u32 {
+    // On the web there is no environment to read `OCS_MSAA_SAMPLES` from, and
+    // `crate::cli` is not compiled for wasm32. WebGL2 multisampling is handled
+    // by the driver with its own sample count, so use the default.
+    #[cfg(target_arch = "wasm32")]
+    {
+        return MSAA_SAMPLES;
+    }
+
+    #[cfg(not(target_arch = "wasm32"))]
+    static CACHE: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    #[cfg(not(target_arch = "wasm32"))]
+    *CACHE.get_or_init(|| {
+        if let Some(raw) = std::env::var_os("OCS_MSAA_SAMPLES") {
+            let raw = raw.to_string_lossy();
+            if let Ok(n) = raw.trim().parse::<u32>() {
+                if matches!(n, 1 | 2 | 4 | 8) {
+                    return n;
+                }
+            }
+        }
+        if crate::cli::gui_config().compat_renderer {
+            1
+        } else {
+            MSAA_SAMPLES
+        }
+    })
+}
 const MSAA_SAMPLES: u32 = 4;
 const SHADOW_MAP_SIZE: u32 = 2048;
 
