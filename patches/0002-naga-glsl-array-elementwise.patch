+    /// Write a type in a *declaration* position (local variable, parameter,
+    /// return type, global).
+    fn write_type_decl(&mut self, ty: Handle<crate::Type>) -> BackendResult {
+        self.write_type(ty)
+    }
+
+    /// If `expr` is a `Compose` that builds an array, return its components.
+    ///
+    /// GLSL ES array constructors are rejected by the Mali driver behind ANGLE
+    /// on WebGL2 whenever their components are not literals: any other operand
+    /// fails with `S0032: no default precision defined for variable 'vec4[8]'`,
+    /// regardless of the precision qualifier on the array itself. Such
+    /// constructors must therefore be replaced by element-wise assignments
+    /// wherever we have a statement to emit them in.
+    fn array_compose_components<'ctx>(
+        &self,
+        expr: Handle<crate::Expression>,
+        ctx: &'ctx back::FunctionCtx,
+    ) -> Option<&'ctx Vec<Handle<crate::Expression>>> {
+        match ctx.expressions[expr] {
+            crate::Expression::Compose { ty, ref components }
+                if matches!(self.module.types[ty].inner, TypeInner::Array { .. }) =>
+            {
+                Some(components)
+            }
+            _ => None,
+        }
+    }
